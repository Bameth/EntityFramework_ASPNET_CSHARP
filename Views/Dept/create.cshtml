@using web.entities
@{
    Layout = "_Layout";
}
@model web.entities.Dept

@{
    ViewData["Title"] = "Enregistrement d'une Dette";
}

<div class="container mx-auto p-6">
    <div
        class="bg-gradient-to-br from-purple-600 via-blue-500 to-indigo-600 shadow-xl rounded-lg p-10 max-w-lg mx-auto mt-10">
        <h1 class="text-4xl font-extrabold text-white text-center mb-6 animate__animated animate__fadeIn">Enregistrement
            d'une dette</h1>

        <form method="POST" action="@Url.Action("Create", "Dept")">
            @Html.AntiForgeryToken()

            <div class="space-y-6">
                <!-- Champ pour Montant -->
                <div class="relative border-b border-gray-300 py-2">
                    <label for="Montant" class="block text-lg font-semibold text-white">Montant</label>
                    <input type="text" id="Montant" name="Montant"
                        class="w-full p-3 rounded-md bg-white bg-opacity-20 focus:outline-none focus:ring-2 focus:ring-indigo-300 text-white"
                        value="@Model.Montant" placeholder="Entrez le Montant de la dette" readonly />
                </div>

                <!-- Sélectionner des articles et quantités -->
                <div class="relative border-b border-gray-300 py-2">
                    <label for="Articles" class="block text-lg font-semibold text-white">Sélectionner des
                        Articles</label>
                    <div id="articlesContainer">
                        @foreach (var article in ViewBag.Articles ?? new List<Articles>())
                        {
                            <div class="flex items-center space-x-3">
                                <input type="checkbox" name="selectedArticleIds" value="@article.Id"
                                    class="article-checkbox">
                                <label>@article.Libelle</label>
                                <input type="number" name="quantities" min="1" value="1" class="article-quantity w-12">
                            </div>
                        }

                    </div>
                </div>

                <!-- Sélectionner un client -->
                <div class="relative border-b border-gray-300 py-2">
                    <label for="ClientId" class="block text-lg font-semibold text-white">Sélectionner un Client</label>
                    <select id="ClientId" name="ClientId"
                        class="w-full p-3 rounded-md bg-white bg-opacity-20 focus:outline-none focus:ring-2 focus:ring-indigo-300 text-blue-800">
                        <option value="">Sélectionner un Client</option>
                        @foreach (var client in ViewBag.Clients ?? new List<Client>())
                        {
                            <option value="@client.Id">@client.Surname (@client.Phone)</option>
                        }

                    </select>
                </div>

                <button type="submit"
                    class="w-full bg-green-500 hover:bg-green-600 text-white font-bold py-3 rounded-lg shadow-lg">
                    <i class="fas fa-save mr-2"></i> Enregistrer
                </button>
            </div>
        </form>

    </div>
</div>
