<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <!-- Import des feuilles de style -->
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link href="https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css" rel="stylesheet">
    <link href="~/css/styles.css" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(90deg, #f3f4f6 0%, #e5e7eb 100%);
        }

        .bg-animated {
            background: linear-gradient(90deg, rgba(59,130,246,1) 0%, rgba(96,165,250,1) 50%, rgba(139,92,246,1) 100%);
            background-size: 400% 400%;
            animation: gradientBG 8s ease infinite;
        }
    </style>

    @* Include custom JavaScript for user menu toggle *@
    <script>
        function toggleUserMenu() {
            const menu = document.getElementById('userMenu');
            menu.classList.toggle('hidden');
        }
    </script>
</head>
<body class="bg-gray-50 text-gray-900">
    <!-- Navbar -->
    <nav class="bg-gradient-to-r from-blue-600 to-indigo-600 shadow-xl p-4 flex justify-between items-center">
        <div class="flex items-center space-x-4">
            <svg class="h-8 w-8 text-white transition-transform transform hover:scale-125" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2c1.054 0 2.052.816 2.05 1.926v16.148c0 1.106-.992 1.926-2.05 1.926s-2.05-.82-2.05-1.926V3.926C9.948 2.816 10.946 2 12 2z" />
            </svg>
            <h1 class="text-2xl font-extrabold text-white">Gestion Boutique</h1>
        </div>
        <div class="relative">
            <img src="https://via.placeholder.com/40" alt="User Photo" class="rounded-full cursor-pointer hover:shadow-lg transition-transform transform hover:scale-110" onclick="toggleUserMenu()">
            <div id="userMenu" class="hidden absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-2 z-20">
                <a href="#" class="block px-4 py-2">Profil</a>
                <a href="#" class="block px-4 py-2">Paramètres</a>
                <a href="#" class="block px-4 py-2">Déconnexion</a>
            </div>
        </div>
    </nav>

    <div class="flex h-screen">
        <!-- Sidebar -->
        <aside class="w-64 bg-animated text-white p-6 shadow-lg">
            <nav class="space-y-6">
                <a href="#" class="sidebar-item text-lg font-semibold p-3 rounded-lg flex items-center">
                    <i class="fas fa-tachometer-alt mr-3"></i> Dashboard
                </a>
                <a href="@Url.Action("Index", "Client")" class="sidebar-item text-lg font-semibold p-3 rounded-lg flex items-center">
                    <i class="fas fa-user-friends mr-3"></i> Clients
                </a>
                <a href="@Url.Action("Index", "Articles")" class="sidebar-item text-lg font-semibold p-3 rounded-lg flex items-center">
                    <i class="fas fa-box-open mr-3"></i> Articles
                </a>
                <a href="@Url.Action("Index", "Dept")" class="sidebar-item text-lg font-semibold p-3 rounded-lg flex items-center">
                    <i class="fas fa-shopping-cart mr-3"></i> Dettes
                </a>
                <a href="#" class="sidebar-item text-lg font-semibold p-3 rounded-lg flex items-center">
                    <i class="fas fa-cogs mr-3"></i> Paramètres
                </a>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 p-10 bg-white rounded-tl-3xl shadow-inner">
            <div class="bg-gradient-to-r from-blue-500 to-purple-600 h-2 rounded-full mb-6"></div>
            <div class="h-full overflow-y-auto">
                @RenderBody()  <!-- Contenu spécifique à chaque page -->
            </div>
        </main>
    </div>
</body>
</html>
