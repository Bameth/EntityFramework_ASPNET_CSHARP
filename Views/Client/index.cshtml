@model ClientPaginationViewModel
@{
    Layout = "_Layout";
}
@{
    ViewData["Title"] = "Gestion des Clients";
}

<div class="bg-gradient-to-br from-indigo-200 to-blue-300 min-h-screen py-6">
    <div class="max-w-7xl mx-auto bg-white shadow-2xl rounded-3xl p-8">
        <div class="flex justify-between items-center mb-8">
            <h1 class="text-4xl font-extrabold text-gray-800 tracking-tight hover:text-indigo-600 transition-all">Liste
                des Clients</h1>
            <a href="@Url.Action("Create", "Client")"
                class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-green-500 to-green-700 text-white rounded-lg shadow-xl hover:shadow-2xl hover:scale-105 transition-all">
                Nouveau
                <svg class="h-6 w-6 ml-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
            </a>
        </div>

        @* Affichage du message de succès *@
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-4 p-4 bg-green-100 text-green-700 border-l-4 border-green-500 rounded-lg shadow-lg">
                <i class="fas fa-check-circle mr-2"></i>
                @TempData["SuccessMessage"]
            </div>
        }

        <form method="get" action="@Url.Action("Index", "Client")"
            class="flex items-center bg-gray-100 p-4 rounded-lg shadow-inner space-x-4 mb-8">
            <div class="flex-grow">
                <div class="relative">
                    <input type="text" name="telephone" placeholder="Rechercher par téléphone..."
                        class="border border-gray-300 rounded-lg pl-12 pr-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 w-full transition-all" />
                    <span class="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400">
                        <i class="fas fa-phone-alt mt-2"></i>
                    </span>
                </div>
            </div>

            <div class="flex-grow">
                <div class="relative">
                    <input type="text" name="surname" placeholder="Rechercher par surname..."
                        class="border border-gray-300 rounded-lg pl-12 pr-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 w-full transition-all" />
                    <span class="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400">
                        <i class="fas fa-user mt-2"></i>
                    </span>
                </div>
            </div>

            <button type="submit"
                class="px-6 py-3 bg-blue-600 text-white rounded-lg shadow-lg hover:bg-blue-700 transition-colors mt-0 flex items-center">
                <i class="fas fa-search mr-2"></i> Rechercher
            </button>
        </form>

        <div class="overflow-x-auto rounded-3xl shadow-2xl mt-8">
            <table class="min-w-full table-auto bg-white rounded-lg">
                <thead class="bg-gradient-to-r from-blue-600 to-blue-800 text-white uppercase">
                    <tr>
                        <th class="px-6 py-3 text-left text-sm font-semibold tracking-wider">#</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold tracking-wider">Nom et prénom</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold tracking-wider">Surname</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold tracking-wider">Téléphone</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="text-gray-700">
                    @foreach (var client in Model.Clients)
                    {
                        <tr class="hover:bg-gray-100 transition duration-200">
                            <td class="px-6 py-4">@client.Id</td>
                            <td class="px-6 py-4">
                                @if (client.User != null)
                                {
                                    @client.User.Name @client.User.Name
                                }
                                else
                                {
                                    @("Pas d'utilisateur")
                                }
                            </td>

                            <td class="px-6 py-4">@client.Surname</td>
                            <td class="px-6 py-4">@client.Phone</td>
                            <td class="px-6 py-4 flex space-x-4">
                                <a href="@Url.Action("Show", "Client", new { id = client.Id })"
                                    class="text-blue-600 hover:text-blue-800 transition-colors duration-300">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <button class="text-red-600 hover:text-red-800 transition-colors duration-300"
                                    data-toggle="modal" data-target="#deleteModal">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination mt-8 flex justify-center space-x-2">
            @if (Model.CurrentPage > 1)
            {
                <a href="@Url.Action("Index", "Client", new { page = Model.CurrentPage - 1 })"
                    class="px-6 py-3 bg-blue-600 text-white rounded-lg shadow-md hover:bg-blue-700 transition-all duration-300 ease-in-out transform hover:scale-105">
                    Précédent
                </a>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a href="@Url.Action("Index", "Client", new { page = i })"
                    class="px-4 py-3 border border-blue-600 rounded-lg text-sm font-medium hover:bg-blue-600 hover:text-white transition-all duration-300 @(i == Model.CurrentPage ? "bg-blue-600 text-white" : "bg-white text-gray-600")">
                    @i
                </a>
            }

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a href="@Url.Action("Index", "Client", new { page = Model.CurrentPage + 1 })"
                    class="px-6 py-3 bg-blue-600 text-white rounded-lg shadow-md hover:bg-blue-700 transition-all duration-300 ease-in-out transform hover:scale-105">
                    Suivant
                </a>
            }
        </div>

    </div>
</div>
