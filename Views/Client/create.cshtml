@{
    Layout = "_Layout";
}
@model web.entities.Client

@{
    ViewData["Title"] = "Enregistrement d'un Client";
}

<div class="container mx-auto p-6">
    <div class="bg-gradient-to-br from-purple-600 via-blue-500 to-indigo-600 shadow-xl rounded-lg p-10 max-w-lg mx-auto mt-10">
        <h1 class="text-4xl font-extrabold text-white text-center mb-6 animate__animated animate__fadeIn">Enregistrement d'un Client</h1>

        <form method="POST" action="@Url.Action("Create", "Client")">
            @Html.AntiForgeryToken()

            <!-- Champs du formulaire client -->
            <div class="space-y-6">
                <div class="relative border-b border-gray-300 py-2">
                    <label for="Surname" class="block text-lg font-semibold text-white">Nom</label>
                    <div class="flex items-center mt-2">
                        <i class="fas fa-user text-white text-xl mr-2"></i>
                        <input type="text" id="Surname" name="Surname" class="w-full p-3 rounded-md bg-white bg-opacity-20 focus:outline-none focus:ring-2 focus:ring-indigo-300 text-white placeholder-gray-200 transition-all ease-in-out" value="@Model.Surname" placeholder="Entrez le nom" />
                    </div>
                    @if (!string.IsNullOrEmpty(ViewData.ModelState["Surname"]?.Errors.FirstOrDefault()?.ErrorMessage))
                    {
                        <div class="text-red-300 mt-1">@ViewData.ModelState["Surname"].Errors.FirstOrDefault().ErrorMessage</div>
                    }
                </div>

                <div class="relative border-b border-gray-300 py-2">
                    <label for="Phone" class="block text-lg font-semibold text-white">Téléphone</label>
                    <div class="flex items-center mt-2">
                        <i class="fas fa-phone-alt text-white text-xl mr-2"></i>
                        <input type="text" id="Phone" name="Phone" class="w-full p-3 rounded-md bg-white bg-opacity-20 focus:outline-none focus:ring-2 focus:ring-indigo-300 text-white placeholder-gray-200 transition-all ease-in-out" value="@Model.Phone" placeholder="Entrez le téléphone" />
                    </div>
                    @if (!string.IsNullOrEmpty(ViewData.ModelState["Phone"]?.Errors.FirstOrDefault()?.ErrorMessage))
                    {
                        <div class="text-red-300 mt-1">@ViewData.ModelState["Phone"].Errors.FirstOrDefault().ErrorMessage</div>
                    }
                </div>

                <div class="relative border-b border-gray-300 py-2">
                    <label for="Address" class="block text-lg font-semibold text-white">Adresse</label>
                    <div class="flex items-center mt-2">
                        <i class="fas fa-map-marker-alt text-white text-xl mr-2"></i>
                        <input type="text" id="Address" name="Address" class="w-full p-3 rounded-md bg-white bg-opacity-20 focus:outline-none focus:ring-2 focus:ring-indigo-300 text-white placeholder-gray-200 transition-all ease-in-out" value="@Model.Address" placeholder="Entrez l'adresse" />
                    </div>
                    @if (!string.IsNullOrEmpty(ViewData.ModelState["Address"]?.Errors.FirstOrDefault()?.ErrorMessage))
                    {
                        <div class="text-red-300 mt-1">@ViewData.ModelState["Address"].Errors.FirstOrDefault().ErrorMessage</div>
                    }
                </div>
            </div>

            <!-- Toggle pour créer un utilisateur -->
            <div class="mt-6 flex items-center justify-between">
                <span class="text-white font-semibold">Créer un utilisateur pour ce client</span>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" id="toggleUser" name="toggleUser" class="sr-only peer">
                    <div class="w-11 h-6 bg-gray-300 rounded-full peer peer-checked:bg-green-500 transition duration-300 ease-in-out"></div>
                    <div class="w-5 h-5 bg-white rounded-full absolute transform transition-all duration-300 ease-in-out peer-checked:translate-x-5"></div>
                </label>
            </div>

            <!-- Formulaire utilisateur -->
            <div id="userForm" class="mt-4 hidden space-y-4 bg-gray-800 bg-opacity-30 p-4 rounded-lg transition-all ease-in-out">
                <div class="border-b border-gray-300 py-2">
                    <label for="Name" class="block text-white font-semibold">Nom d'utilisateur</label>
                    <input type="text" id="Name" name="Name" class="w-full p-3 rounded-md bg-white bg-opacity-20 text-white placeholder-gray-200 transition-all ease-in-out" placeholder="Entrez le nom d'utilisateur" />
                </div>
                <div class="border-b border-gray-300 py-2">
                    <label for="Login" class="block text-white font-semibold">Login</label>
                    <input type="text" id="Login" name="Login" class="w-full p-3 rounded-md bg-white bg-opacity-20 text-white placeholder-gray-200 transition-all ease-in-out" placeholder="Entrez le login" />
                </div>
                <div class="border-b border-gray-300 py-2">
                    <label for="Password" class="block text-white font-semibold">Mot de passe</label>
                    <input type="password" id="Password" name="Password" class="w-full p-3 rounded-md bg-white bg-opacity-20 text-white placeholder-gray-200 transition-all ease-in-out" placeholder="Entrez le mot de passe" />
                </div>
            </div>

            <!-- Bouton de soumission -->
            <button type="submit" class="w-full bg-green-500 hover:bg-green-600 text-white font-bold py-3 rounded-lg shadow-lg transition duration-150 ease-in-out transform hover:scale-105 mt-6 flex items-center justify-center">
                <i class="fas fa-save mr-2"></i> Enregistrer
            </button>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const toggleUser = document.getElementById('toggleUser');
        const userForm = document.getElementById('userForm');

        toggleUser.addEventListener('change', function () {
            if (toggleUser.checked) {
                userForm.classList.remove('hidden');
            } else {
                userForm.classList.add('hidden');
            }
        });
    });
</script>
